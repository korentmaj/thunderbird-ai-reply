{
  "manifest_version": 2,
  "name": "AI reply",
  "version": "1.1.0",
  "description": "Draft a reply to the open mail with Claude Code running on your own machine, streamed into the compose window.",
  "author": "Maj Korent",
  "browser_specific_settings": { "gecko": { "id": "ai-reply@korent.dev", "strict_min_version": "128.0" } },
  "permissions": ["messagesRead", "compose", "nativeMessaging", "accountsRead", "notifications"],
  "background": { "scripts": ["background.js"] },
  "icons": { "16": "icon.svg", "32": "icon.svg" },
  "message_display_action": {
    "default_title": "Write reply with AI",
    "default_label": "AI reply",
    "default_icon": "icon.svg",
    "default_popup": "popup.html"
  }
}
